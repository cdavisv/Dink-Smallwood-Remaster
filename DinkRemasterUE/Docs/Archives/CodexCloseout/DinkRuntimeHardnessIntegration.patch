+    for(auto& C:Carries)
+    {
+        auto& S=*C.Sprite;
+        if(S.Origin.IsValid())
+        {
+            if(S.HardnessEditorIndex==0)S.HardnessEditorIndex=S.Origin.Placement;
+            if(!S.bRetainedOriginalEditor)
