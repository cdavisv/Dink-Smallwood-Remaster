+bool UDinkDirector::CarryOriginalLiveSprites(int32 Screen,FString& Error)
+{
+    struct FCarry {FDinkSprite* Sprite;FVector World;};
+    TArray<FCarry> Carries;
+    for(auto& Pair:Sprites)
+    {
+        auto& S=Pair.Value;
+        if(S.Handle==1||!S.bActive||!S.GetProp(TEXT("live"))||S.Screen==Screen)continue;
+        // Editor sp_index has cross-smallMap semantics. Until that separate
+        // owner/source identity is represented, never move authored actors or
+        // silently reassign their persistent Origin to another screen.
+        if(S.Origin.IsValid()){Error=TEXT("cross-screen editor-origin live carry requires separate owner identity");return false;}
+        FVector World=FVector::ZeroVector;
+        if(const AActor* Actor=S.Actor.Get())
+        {
+            FVector Before;
+            if(!PixelToWorld(S.Screen,S.X,S.Y,Before)||!PixelToWorld(Screen,S.X,S.Y,World))
+            {Error=TEXT("retained live actor screen transform unavailable");return false;}
+            World.Z+=Actor->GetActorLocation().Z-Before.Z;
+        }
+        Carries.Add({&S,World});
+    }
+    // All possible failures precede any identity or actor transform mutation.
+    for(auto& Carry:Carries)
+    {
+        DinkHardness::CarryLiveScreenIdentity(*Carry.Sprite,Screen);
+        if(AActor* Actor=Carry.Sprite->Actor.Get())
+        {MakeMovable(Actor);Actor->SetActorLocation(Carry.World,false,nullptr,ETeleportType::TeleportPhysics);}
+    }
+    Error.Reset();return true;
+}
