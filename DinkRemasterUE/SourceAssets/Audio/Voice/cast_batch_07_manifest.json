     "duration_s": "4.160000",
     "bytes": 84878
    },
    {
     "id": "s1-mh-f.talk.009",
     "text": "your training.",
     "tts_text": "your training.",
     "generation_id": "9S1NC6CMoVlBQkgo7NJa",
     "node_id": "WtGaCOMv9EJO7KLAzCD1",
     "credits": 14,
     "file": "martridge/s1-mh-f.talk.009.mp3",
