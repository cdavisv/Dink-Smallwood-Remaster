     "duration_s": "0.880000",
     "bytes": 32215
    },
    {
     "id": "s4-h2p3.talk.002",
     "text": "Hi mister, thanks for letting us all eat.",
     "tts_text": "Hi mister, thanks for letting us all eat.",
     "generation_id": "3v63OCiB3AUCzDg2Zizr",
     "node_id": "IGbb2zgK13RCjk70oEyE",
     "credits": 41,
     "file": "girl/s4-h2p3.talk.002.mp3",
     "sha256": "482bc6dd13abe417e77564af970fc97bc0c684eceb77e884c2f6a719329c7a6a",
     "duration_s": "2.640000",
     "bytes": 60636
    },
    {
     "id": "s4-h2p3.talk.005",
     "text": "Hi mister.",
     "tts_text": "Hi mister.",
     "generation_id": "uQhhcjcS3NqnU9sCFVqb",
     "node_id": "OvdbSK07EFaq6gYbOF31",
     "credits": 10,
     "file": "girl/s4-h2p3.talk.005.mp3",
     "sha256": "32b1fd0ac645ce39a0f9ea89207da97384192157e395b737070434660370b815",
     "duration_s": "0.960000",
     "bytes": 33469
    },
    {
     "id": "s4-h2p3.talk.007",
     "text": "Not much lately, mommy says we can't eat that much,",
     "tts_text": "Not much lately, mommy says we can't eat that much,",
     "generation_id": "78mOY720IEdj4aRCtiRX",
     "node_id": "KyeSQH2xbSJa19TNrm1O",
     "credits": 51,
     "file": "girl/s4-h2p3.talk.007.mp3",
