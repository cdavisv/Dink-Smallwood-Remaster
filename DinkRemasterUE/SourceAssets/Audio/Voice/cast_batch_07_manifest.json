     "duration_s": "3.440000",
     "bytes": 73175
    },
    {
     "id": "s1-mh-f.talk.006",
     "text": "I unfortunately have been called away and cannot",
     "tts_text": "I unfortunately have been called away and cannot",
     "generation_id": "lSIAh5JxIWjSPZltdefU",
     "node_id": "EOTzbvhW18bKtiKLDkfj",
     "credits": 48,
     "file": "martridge/s1-mh-f.talk.006.mp3",
