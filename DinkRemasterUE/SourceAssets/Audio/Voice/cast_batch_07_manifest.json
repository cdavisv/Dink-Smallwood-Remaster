     "duration_s": "1.600000",
     "bytes": 43918
    },
    {
     "id": "s4-h2p3.talk.009",
     "text": "I don't like the ducks.",
     "tts_text": "I don't like the ducks.",
     "generation_id": "E3q5SRIIghxK2ADsyz0t",
     "node_id": "yuE1wEYStmD6Lo9pOjmc",
     "credits": 23,
     "file": "girl/s4-h2p3.talk.009.mp3",
