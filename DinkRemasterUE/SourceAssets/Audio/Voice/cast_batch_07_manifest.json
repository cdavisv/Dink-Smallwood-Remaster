    {
     "id": "s1-mh-f.talk.003",
     "text": "Dear Dink,",
     "tts_text": "Dear Dink,",
     "generation_id": "j5Zo7dmz5McOwoC4tDfo",
     "node_id": "fMuz5eSWodtdSYu7YIsY",
     "credits": 10,
