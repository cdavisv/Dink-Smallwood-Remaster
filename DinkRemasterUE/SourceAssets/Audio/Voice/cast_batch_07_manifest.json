    },
    {
     "id": "s4-end.main.024",
     "text": "Bye, Dink.",
     "tts_text": "Bye, Dink.",
     "generation_id": "4OtZwydPqzcqGHiHYvS0",
     "node_id": "HyPE0rrRiiccjYHFDXzv",
     "credits": 10,
     "file": "girl/s4-end.main.024.mp3",
