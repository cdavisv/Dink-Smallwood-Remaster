     "duration_s": "3.360000",
     "bytes": 71921
    },
    {
     "id": "s4-h2p3.talk.008",
     "text": "because of the ducks.",
     "tts_text": "because of the ducks.",
     "generation_id": "Btnj21jstfKFUHXiDCYD",
     "node_id": "1OHp7WT8X00g2NPg2Saz",
     "credits": 21,
     "file": "girl/s4-h2p3.talk.008.mp3",
