     "duration_s": "4.320000",
     "bytes": 87386
    },
    {
     "id": "s1-mh-f.talk.008",
     "text": "teachers out there, you will find one and further",
     "tts_text": "teachers out there, you will find one and further",
     "generation_id": "UJip88XJ0cu6YfL1Bsmf",
     "node_id": "0JwoqLMta51CvE4ynebq",
     "credits": 49,
