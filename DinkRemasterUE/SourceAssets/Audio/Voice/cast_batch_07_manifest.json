     "duration_s": "1.520000",
     "bytes": 42664
    },
    {
     "id": "s1-mh-f.talk.004",
     "text": "If you're able to see this then it means you",
     "tts_text": "If you're able to see this then it means you",
     "generation_id": "Yhfy2560gDXVKAimdxx2",
     "node_id": "eMpb6nUyjURXDvst3coA",
     "credits": 44,
