     "duration_s": "1.360000",
     "bytes": 40156
    },
    {
     "id": "s1-mh-f.talk.010",
     "text": "There are 200 gold pieces enclosed, spend them wisely.",
     "tts_text": "There are 200 gold pieces enclosed, spend them wisely.",
     "generation_id": "eebLGln7vUVqnbJnEuQm",
     "node_id": "KbzRBEgdiZIpcGlcUkt4",
