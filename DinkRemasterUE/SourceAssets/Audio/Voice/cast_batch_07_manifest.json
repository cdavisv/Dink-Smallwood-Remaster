     "duration_s": "1.920000",
     "bytes": 48933
    },
    {
     "id": "s4-h2p3.hit.001",
     "text": "No mister!",
     "tts_text": "No mister!",
     "generation_id": "3QbNeBYyKxcOLfe1UM8e",
     "node_id": "NalB7Y4wBUoo8HfhwWYu",
     "credits": 10,
     "file": "girl/s4-h2p3.hit.001.mp3",
     "sha256": "3426c49c1c591252046b149140c3ee5265e0c7dfae7e330ce06f46c8313ab9e1",
     "duration_s": "1.360000",
     "bytes": 40156
    },
    {
     "id": "s5-end.main.002",
     "text": "Dink, you saved me!  You are a hero!",
     "tts_text": "Dink, you saved me! You are a hero!",
     "generation_id": "Vtt0Yerz5B7c8VAI8V7d",
     "node_id": "wt8taTNKqBOESbn8zcXx",
     "credits": 35,
     "file": "girl/s5-end.main.002.mp3",
     "sha256": "7054ba22baec57db57b807cdced4184472891741151745b6278ce97c85ba08b4",
     "duration_s": "3.520000",
     "bytes": 74429
    },
    {
     "id": "s5-fd.talk.001",
     "text": "Where did you learn to fight like that?",
     "tts_text": "Where did you learn to fight like that?",
     "generation_id": "tzM7VZvzui4SN1v3CdD3",
     "node_id": "FeX1c5yPEsBQLUegcrsc",
     "credits": 39,
     "file": "girl/s5-fd.talk.001.mp3",
     "sha256": "4d8ac2e4184782f00be38830a20caf6d34c9b880b67a5d88798ada2322e712e9",
     "duration_s": "2.080000",
     "bytes": 51441
    },
    {
     "id": "s5-fguy.main.002",
     "text": "Oh mother!  I've been so afraid!",
     "tts_text": "Oh mother! I've been so afraid!",
     "generation_id": "v9vXaEvVzrGFGdrAKguf",
     "node_id": "g1m4BTh1M92bV0H3IobT",
