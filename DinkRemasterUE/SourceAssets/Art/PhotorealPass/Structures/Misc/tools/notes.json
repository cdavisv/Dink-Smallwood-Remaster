 "modules": {
  "SM_Bridge_Wood_Deck_PR": {
   "known_weaknesses": "Planks read as real riven boards (OakWeathered scan, per-board grain); faults: plank ends are square-sawn, the broken plank is simply shorter, spike heads are small dark discs, stringers are plain round poles without bark or lashings; no moss or wet staining specific to a river."
  },
  "SM_Bridge_Wood_Rail_Rope_PR": {
   "known_weaknesses": "Rope is a 12-sided twisted three-lobe sweep: reads as laid rope at gameplay distance, shows facets and a straw-coloured thatch scan at 1 m; the hitch on the post is a stack of round turns; struts are plain poles. 3,300 triangles for one post and 2.5 m of rope."
  },
  "SM_Bridge_Wood_Rail_Plank_PR": {
   "known_weaknesses": "As the rope rail; the hung boards are convincing wood but all end square, top and bottom, and their nails are dots."
  },
  "SM_Bridge_Stone_PR": {
   "known_weaknesses": "Reads as an old bridge from the gameplay camera. Faults: spandrel faces are a rubble scan on a sheet with applied voussoirs and string course (joints do not follow the scan); deck flags all carry the same FieldBoulder scan so their white veins repeat; no cutwaters, no parapet coping beyond the merlons, soffit is plain; moss is vertex colour. Hard line where it meets the ground (it is meant to stand in a river bed)."
  },
  "SM_Door_Wood_Single_PR": {
   "known_weaknesses": "Last review found a believable ledged door at 1 m. Faults: boards square-ended and evenly weathered, no kick wear or rot at the foot beyond a vertex-colour darkening; ironwork is the black alpha-switch iron (flat colour, no forge texture); the draw bar and ledges are plain planed timber."
  },
  "SM_Door_Wood_Wide_PR": {
   "known_weaknesses": "As the single door."
  },
  "SM_SignPost_Single_PR": {
   "known_weaknesses": "Boards are riven planks with slanted broken ends; no lettering or carving at all (the game shows the text), so the boards are blank; small dark slivers at some board ends where the end cut folds; post is a clean chamfered timber."
  },
  "SM_SignPost_Double_PR": {
   "known_weaknesses": "As the single sign."
  },
  "SM_SignPost_Triple_PR": {
   "known_weaknesses": "As the single sign; the pointing boards are only 10 cm longer in the middle plank, not cut to arrows as the sprite suggests."
  },
  "SM_Chimney_Stone_Short_PR": {
   "known_weaknesses": "Individually set FieldBoulder blocks over a mortared core read as real masonry; the soot at the top is only a dirt darkening; flue is a black box."
  },
  "SM_Chimney_Stone_Tall_PR": {
   "known_weaknesses": "As the short stack; the two offsets are single tilted stones each side, crude; greyer than the buff fieldstone of the cottages it stands against."
  },
  "SM_Cottage_Thatched_TwoStorey_PR": {
   "known_weaknesses": "Built from the Stonebrook cottage generator, so it shares that kit's faults (quoins and footing stones carry the rubble scan, thatch courses read as stacked plates from below, 0.54 m thatch scan period). New faults: the upper storey is a blank box with no window; the pentice thatch dies into the upper wall in a hard line with no flashing or mortar fillet; inside the pentice the lower cottage's hidden chimney and hip rolls are still there (wasted triangles); zero-area faces from the clipped thatch planes."
  },
  "SM_Cottage_Thatched_LShape_PR": {
   "known_weaknesses": "As the two-storey cottage; the wing simply intersects the main block (thatch through thatch, wall through wall) with no valley; 63,000 triangles (soft target 60,000)."
  },
  "SM_Island_Hut_Round_PR": {
   "known_weaknesses": "Identity is right (blue dado with stepped border, olive wall, ox-blood jambs, crossed tusks, domed thatch with ties). Faults: the paint colours are flat tints of one plaster scan with per-face steps, no brush marks or flaking; tusks and ribs are smooth tapered sweeps of a plaster scan, clean and white; thatch sectors are regular with visible course plates and a fringe that is a wavy edge, not hanging straw; the doorway is a black box; 7 material slots (limit 6)."
  },
  "SM_Island_Hut_TwoStorey_PR": {
   "known_weaknesses": "As the round hut; the upper drum simply stands through the lower roof; 47,900 triangles."
  },
  "SM_Island_Fence_Lattice_PR": {
   "known_weaknesses": "Canes are straight sweeps with node rings on a tinted oak scan: read as bamboo at gameplay distance, as painted dowels at 1 m; lashings are stacked round turns."
  },
  "SM_Island_TorchPole_PR": {
   "known_weaknesses": "Simple: a cane, three tines, a wound red strip; tips are black, no burnt texture."
  }
 },
 "validator": {
  "tool": "tools/blender/dinkasset/validate.py on Misc.blend (report Misc/validation.json)",
  "errors_by_design": {
   "UV_OVERLAP (all but the buildings)": "tiling UVs at real texel density, no unique unwrap",
   "PIVOT on SM_Bridge_Wood_Deck_PR, SM_Bridge_Wood_Rail_*, SM_Bridge_Stone_PR": "origin is at walking level so the pieces snap to the bank height; stringers, post feet and arches hang below it",
   "PIVOT on SM_Island_Hut_*": "origin is the centre of the round drum; the bounds are pulled forward by the tusks and the trodden apron at the door",
   "SLOTS_OVER on SM_Island_Hut_* (7, limit 6)": "the three wall paints are separate tiling materials",
   "ZERO_AREA on the cottages": "slivers where the Stonebrook thatch generator clips a plane; inherited",
   "PIVOT on SM_SignPost_Triple_PR, SM_Island_Fence_Lattice_PR": "origin is the foot of the post / the centre line of the posts; boards and packing stones make the bounds lopsided by 3-4 cm"
  },
  "warnings": "NAME_TEXTURE, TEXEL_DENSITY, UV_RANGE, UV_DEGENERATE (tiling), DUPLICATE_VERTS (touching blocks), TRIS_OVER_TARGET on SM_Cottage_Thatched_LShape_PR and the rope rails",
  "result": "17 assets, 0 pass: 28 errors, all by design or inherited (12 UV_OVERLAP, 8 PIVOT, 2 SLOTS_OVER, 6 ZERO_AREA findings on the two cottages); summary in Misc/validation_summary.json"
 },
 "not_done": "Three-arch long stone bridge (frame 4; build stone_bridge(L=12, narches=3)); diagonal and vertical views of the lattice fence are the same mesh yawed; island spear poles (frames 13-17); log cabin family 59; nothing imported into Unreal.",
 "render_dir": "misc3",
 "integration": {
  "contract": {
   "uv": "UV0 already carries the tiling: one UV unit is one repeat of the set (tile_size_m is the nominal size the UVs were laid out for; small blocks use up to 2x denser UVs). Sample BC, N, ORM and H at UV0; sample Macro at UV0 / 7. Do not rescale.",
   "textures": "BC sRGB; N linear OpenGL (flip green on import); ORM linear (R ambient occlusion, G roughness, B metallic = 0); H linear 16-bit height, used 0..1; Macro linear 512 px (R large, G medium, B small variation).",
   "vertex_colour": "FBX vertex colour set 'Grime', linear RGBA float, exported with every LOD. R = dirt and damp, G = moss / algae, B = bleaching (silvered oak, lichen, dressed stone, fresh straw), A = material switch (see below; 1 everywhere else).",
   "graph": [
    "base = BC * tint * (1 - macro + 2 * macro * Macro.R)",
    "base = lerp(base, base * ORM.R, 0.5)",
    "fd = saturate(R * (1.15 - 0.5 * H))",
    "dirt_mode multiply: c = lerp(base, base * dirt, fd * dirt_amount);   dirt_mode mix: c = lerp(base, dirt * (3 * luminance(base) + 0.35), fd * dirt_amount)",
    "fb = saturate(B * saturate(0.9 * H + 0.35));   c = lerp(c, pale * (2.2 * luminance(c) + 0.55), fb * pale_amount)",
    "fm = saturate(4 * ((G + 0.5 * Macro.B) - (0.55 * H + 0.62))) * (G > 0.02);   c = lerp(c, moss * (0.9 * Macro.G + 0.55), fm)",
    "roughness = lerp(ORM.G, moss_roughness, fm) - 0.10 * fd;   normal = N;   metallic = 0",
    "alpha_switch materials only: A < 0.875 lead (only where alpha_lead is true): colour (0.15, 0.16, 0.17) * (0.7 * Macro.G + 0.65), roughness 0.42, flat normal;  A < 0.625 (A < 0.75 where alpha_lead is false) black iron, charred wood, burnt straw or unlit void: colour (0.016, 0.015, 0.014), roughness 0.5 + 0.42 * R (iron has R = 0, char has R = 1), normal kept;  A < 0.25 window glass: colour glass_tint, roughness 0.06, flat normal, opaque (the pane mesh is faceted so each quarry reflects differently; a dark closed box stands behind it). Values written: 1, 0.75, 0.5, 0.",
    "alpha_soot materials only: fs = saturate((1 - A) * (0.7 * Macro.G + 1.0));  c = lerp(c, (0.012, 0.011, 0.010), fs);  roughness = lerp(roughness, 0.97, fs)"
   ],
   "colours": "all colours are linear RGB",
   "fbx": "One FBX per asset beside the manifest: mesh objects <asset>_LOD0, _LOD1, _LOD2 (import as one static mesh with three LODs) and UCX_<asset>_LOD0_NN convex hulls; metres with UnitScaleFactor 100; Z up, front -Y; smoothing by edge (import normals); material slots in the order of each module's \"materials\" list. Family meshes are visual only (ART_STANDARD section 5)."
  },
